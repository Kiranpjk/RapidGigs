# Copy to backend/.env for `npm run dev`. Never commit the real .env file.
PORT=3001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/rapidgig
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI providers (all optional)
OPENROUTER_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
HUGGINGFACE_TOKEN=

# Payment service (same key in both services)
PAYMENT_SERVICE_URL=http://localhost:8081
PAYMENT_SERVICE_KEY=dev

# n8n
N8N_WEBHOOK_SECRET=change-me
