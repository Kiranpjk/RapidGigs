{
    "name": "rapidgig-backend",
    "version": "1.0.0",
    "description": "Backend API for RapidGig platform",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "bash start.sh",
        "seed:demo": "tsx src/scripts/seed-demo.ts",
        "migrate": "node node_modules/tsx/dist/cli.mjs src/config/database.ts",
        "test": "tsx --test \"src/**/*.test.ts\"",
        "import:listings": "tsx src/scripts/import-listings.ts",
        "test:veo": "tsx src/scripts/test_veoaifree_puppeteer.ts"
    },
    "dependencies": {
        "@fal-ai/client": "^1.11.0",
        "axios": "^1.15.0",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.11.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.7.5",
        "express-validator": "^7.3.2",
        "fluent-ffmpeg": "^2.1.3",
        "google-auth-library": "^10.5.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "magic-hour": "^0.94.1",
        "mongoose": "^8.0.3",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^4.6.0",
        "nodemailer": "^10.6.0",
        "puppeteer": "^25.18.1",
        "puppeteer-extra": "^3.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "socket.io": "^4.8.4",
        "together-ai": "^0.39.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/mongoose": "^5.11.97",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.10.5",
        "mongodb-memory-server": "^11.3.0",
        "tsx": "^4.23.15",
        "typescript": "^5.3.3"
    },
    "overrides": {
        "make-api-request-js": {
            "zod": "^4.6.6"
        },
        "magic-hour": {
            "zod": "^4.6.6"
        }
    }
