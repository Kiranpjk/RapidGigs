# Copy to .env and fill in. Used by `docker compose up`.
# Never commit the real .env file.

# Required
JWT_SECRET=change-me-to-a-long-random-string
PAYMENT_SERVICE_KEY=change-me
N8N_WEBHOOK_SECRET=change-me

# Optional
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUGGINGFACE_TOKEN=

# Optional AI / media providers (passed to the backend through env_file)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENROUTER_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
